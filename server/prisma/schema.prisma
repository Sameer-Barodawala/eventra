datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("USER")
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@map("users")
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  posterUrl   String
  bannerUrl   String
  genre       String
  duration    Int      // duration in minutes
  language    String
  rating      Float    @default(8.5)
  releaseDate DateTime
  createdAt   DateTime @default(now())
  shows       Show[]

  @@map("movies")
}

model Theatre {
  id       Int      @id @default(autoincrement())
  name     String
  city     String
  location String
  screens  Screen[]

  @@map("theatres")
}

model Screen {
  id         Int      @id @default(autoincrement())
  theatreId  Int
  theatre    Theatre  @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Screen 1 - IMAX"
  totalSeats Int
  seats      Seat[]
  shows      Show[]

  @@map("screens")
}

model Seat {
  id           Int           @id @default(autoincrement())
  screenId     Int
  screen       Screen        @relation(fields: [screenId], references: [id], onDelete: Cascade)
  seatRow      String        // e.g., "A", "B", "C"
  seatNumber   Int           // e.g., 1, 2, 3
  seatType     String        // "SILVER", "GOLD", "PLATINUM"
  bookingSeats BookingSeat[]

  @@unique([screenId, seatRow, seatNumber])
  @@map("seats")
}

model Show {
  id        Int       @id @default(autoincrement())
  movieId   Int
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  screenId  Int
  screen    Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  price     Float     // Base price for Silver seat
  bookings  Booking[]

  @@map("shows")
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  showId        Int
  show          Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  totalAmount   Float
  bookingStatus String        @default("CONFIRMED") // "CONFIRMED", "CANCELLED"
  bookingDate   DateTime      @default(now())
  bookingSeats  BookingSeat[]

  @@map("bookings")
}

model BookingSeat {
  id        Int     @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    Int
  seat      Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatId])
  @@map("booking_seats")
}
